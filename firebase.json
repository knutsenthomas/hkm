{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "redirects": [
      { "source": "/category/cups-bottles", "destination": "https://www.hiskingdomdesigns.no/category/cups-bottles", "type": 301 },
      { "source": "/category/kopper", "destination": "https://www.hiskingdomdesigns.no/category/cups-bottles", "type": 301 },
      { "source": "/category/kl%C3%A6r", "destination": "https://www.hiskingdomdesigns.no/category/kl%C3%A6r", "type": 301 },
      { "source": "/category/klaer", "destination": "https://www.hiskingdomdesigns.no/category/kl%C3%A6r", "type": 301 },
      { "source": "/category/klistermerker", "destination": "https://www.hiskingdomdesigns.no/category/klistermerker", "type": 301 },
      { "source": "/category/stickers", "destination": "https://www.hiskingdomdesigns.no/category/klistermerker", "type": 301 },
      { "source": "/category/gavekort", "destination": "https://www.hiskingdomdesigns.no/category/gavekort", "type": 301 },
      { "source": "/category/all-products", "destination": "https://www.hiskingdomdesigns.no/category/all-products", "type": 301 },
      { "source": "/category", "destination": "https://www.hiskingdomdesigns.no/category/all-products", "type": 301 },
