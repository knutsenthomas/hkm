      { "source": "/product-page", "destination": "https://www.hiskingdomdesigns.no/category/all-products", "type": 301 },
      { "source": "/product/:path*", "destination": "https://www.hiskingdomdesigns.no/product-page/:path*", "type": 301 },
      { "source": "/products/:path*", "destination": "https://www.hiskingdomdesigns.no/product-page/:path*", "type": 301 },
      { "source": "/produkt/:path*", "destination": "https://www.hiskingdomdesigns.no/product-page/:path*", "type": 301 },
      { "source": "/produkter/:path*", "destination": "https://www.hiskingdomdesigns.no/product-page/:path*", "type": 301 },
