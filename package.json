{
    "name": "hiskingdomministry",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "npm run watch:css & npm run dev:vite",
        "dev:vite": "vite",
        "build": "npm run build:css && vite build && node scripts/postbuild.mjs",
        "sitemap": "node scripts/generate_multilingual_sitemap.mjs",
        "sitemap:audit": "node scripts/audit_sitemap.mjs",
        "build:css": "tailwindcss -i ./input.css -o ./styles.css --minify",
        "watch:css": "tailwindcss -i ./input.css -o ./styles.css --watch",
        "preview": "vite preview",
        "emulators": "firebase emulators:start --only functions",
        "dev:local": "npm run watch:css & npm run dev:vite & npm run emulators"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^5.2.0",
        "tailwindcss": "^3.4.1",
        "vite": "^6.2.0"
    },
    "dependencies": {
        "@google/genai": "^2.9.0",
        "@wix/inbox": "^1.0.115",
        "@wix/sdk": "^1.21.16",
        "firebase": "^12.15.0",
        "jsdom": "^28.1.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6"
    }
}
