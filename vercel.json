    { "source": "/hvem-vi-er", "destination": "/om-oss", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/getPodcast", "destination": "/api/podcast" },
    { "source": "/podcast", "destination": "/podcast.html" },
    { "source": "/en/podcast", "destination": "/en/podcast.html" },
    { "source": "/es/podcast", "destination": "/es/podcast.html" },
    { "source": "/__/auth/:path*", "destination": "https://his-kingdom-ministry.firebaseapp.com/__/auth/:path*" },
    { "source": "/api/newsletter-unsubscribe", "destination": "https://us-central1-his-kingdom-ministry.cloudfunctions.net/unsubscribeNewsletter" },
    { "source": "/api/bible/:path*", "destination": "/api/bible" },
    { "source": "/kurs", "destination": "/api/share-preview?type=course&lang=no" },
    { "source": "/kurs.html", "destination": "/api/share-preview?type=course&lang=no" },
    { "source": "/en/courses", "destination": "/api/share-preview?type=course&lang=en" },
    { "source": "/en/courses.html", "destination": "/api/share-preview?type=course&lang=en" },
    { "source": "/es/cursos", "destination": "/api/share-preview?type=course&lang=es" },
    { "source": "/es/cursos.html", "destination": "/api/share-preview?type=course&lang=es" },
    { "source": "/leseplan-detaljer", "destination": "/api/share-preview?lang=no" },
    { "source": "/leseplan-detaljer.html", "destination": "/api/share-preview?lang=no" },
    { "source": "/en/reading-plan-details", "destination": "/api/share-preview?lang=en" },
    { "source": "/en/reading-plan-details.html", "destination": "/api/share-preview?lang=en" },
    { "source": "/es/detalles-plan-lectura", "destination": "/api/share-preview?lang=es" },
    { "source": "/es/detalles-plan-lectura.html", "destination": "/api/share-preview?lang=es" },
    { "source": "/blogg-post", "destination": "/api/share-preview?type=blog&lang=no" },
    { "source": "/blogg-post.html", "destination": "/api/share-preview?type=blog&lang=no" },
    { "source": "/en/blog-post", "destination": "/api/share-preview?type=blog&lang=en" },
    { "source": "/en/blog-post.html", "destination": "/api/share-preview?type=blog&lang=en" },
    { "source": "/es/blog-post", "destination": "/api/share-preview?type=blog&lang=es" },
    { "source": "/es/blog-post.html", "destination": "/api/share-preview?type=blog&lang=es" },
    { "source": "/arrangement-detaljer", "destination": "/api/share-preview?type=event&lang=no" },
    { "source": "/arrangement-detaljer.html", "destination": "/api/share-preview?type=event&lang=no" },
    { "source": "/en/event-details", "destination": "/api/share-preview?type=event&lang=en" },
    { "source": "/en/event-details.html", "destination": "/api/share-preview?type=event&lang=en" },
    { "source": "/es/detalles-evento", "destination": "/api/share-preview?type=event&lang=es" },
    { "source": "/es/detalles-evento.html", "destination": "/api/share-preview?type=event&lang=es" },
    { "source": "/en/blog", "destination": "/en/blog.html" },
    { "source": "/es/blog", "destination": "/es/blog.html" },
    { "source": "/avmeld", "destination": "/avmeld.html" }
  ],
  "functions": {
    "api/share-preview.js": {
      "includeFiles": "dist/**/*-template.html"
    }
  },
  "headers": [
    {
      "source": "/__/auth/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; frame-ancestors *;"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; frame-ancestors 'self';"
        }
      ]
    }
  ]
}
